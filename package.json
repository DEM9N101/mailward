    "test": "node --test \"test/**/*.test.js\"",
    "lint": "node --check bin/mailward.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "dmarc",
    "spf",
    "dkim",
    "bimi",
    "mta-sts",
    "tls-rpt",
    "email",
    "email-security",
    "email-authentication",
    "deliverability",
    "phishing",
    "spoofing",
    "dns",
    "doh",
    "cli"
  ],
